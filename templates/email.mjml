<mjml>
  <mj-head>
    <mj-title>NewsWatch · {{ job_name }}</mj-title>
    <mj-preview>{{ articles|length }} new articles from {{ job_name }}</mj-preview>

    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" />
      <mj-text font-size="15px" color="#374151" line-height="1.6" />
      <mj-divider border-color="#e5e7eb" border-width="1px" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#f5f5f7" width="600px">

    <!-- TOP ACCENT BAR -->
    <mj-section background-color="#2563eb" padding="0">
      <mj-column>
        <mj-spacer height="4px" />
      </mj-column>
    </mj-section>

    <!-- HEADER -->
    <mj-section background-color="#ffffff" padding="40px 32px 28px 32px">
      <mj-column>
        <mj-text
          font-size="11px"
          font-weight="700"
          color="#2563eb"
          letter-spacing="2px"
          text-transform="uppercase"
          padding="0 0 10px 0"
          line-height="1">
          NewsWatch Digest
        </mj-text>
        <mj-text
          font-size="30px"
          font-weight="700"
          color="#111827"
          padding="0 0 10px 0"
          line-height="1.2">
          {{ job_name }}
        </mj-text>
        <mj-text
          font-size="14px"
          color="#6b7280"
          padding="0"
          line-height="1.5">
          {{ articles|length }} articles &nbsp;·&nbsp; Last updated {{ updated }}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- HEADER / BODY DIVIDER -->
    <mj-section background-color="#ffffff" padding="0 32px">
      <mj-column>
        <mj-divider border-color="#e5e7eb" padding="0" />
      </mj-column>
    </mj-section>

    <!-- ARTICLES — loop inside a single mj-text -->
    <mj-section background-color="#ffffff" padding="0">
      <mj-column>
        <mj-text padding="0" line-height="1.6">
{% for article in articles %}
<div style="padding: 28px 32px 8px 32px;">
  <a href="{{ article.url }}" style="font-size: 17px; font-weight: 600; color: #111827; text-decoration: none; line-height: 1.4;">
    {{ article.title }}
  </a>
</div>
<div style="padding: 0 32px 28px 32px; font-size: 13px; color: #6b7280; line-height: 1.5;">
  <span style="color: #2563eb; font-weight: 600;">{{ article.source }}</span>
  <span style="color: #d1d5db;">&nbsp;·&nbsp;</span>
  {{ article.published | format_date }}
</div>
{% if not loop.last %}
<div style="border-top: 1px solid #f3f4f6; margin: 0 32px;"></div>
{% endif %}
{% endfor %}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- BOTTOM SPACER -->
    <mj-section background-color="#ffffff" padding="0 32px 32px 32px">
      <mj-column>
        <mj-spacer height="16px" />
      </mj-column>
    </mj-section>

    <!-- FOOTER -->
    <mj-section background-color="#f5f5f7" padding="28px 32px">
      <mj-column>
        <mj-text
          font-size="12px"
          font-weight="600"
          color="#6b7280"
          align="center"
          padding="0 0 6px 0"
          line-height="1.5">
          Generated by NewsWatch
        </mj-text>
        <mj-text
          font-size="11px"
          color="#9ca3af"
          align="center"
          padding="0"
          line-height="1.5">
          Automated news monitoring for "{{ job_name }}"
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>